# 统一行尾。这个库要在 Windows / Linux / 后续 macOS 上构建，也包含 shell
# 脚本，所以全部按 LF 存储与检出。
#
# 例外：给 MSVC 用的 .bat/.ps1/.sln 保留 CRLF（有些老工具对 LF 不友好）。
* text=auto eol=lf

*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.sln   text eol=crlf
*.vcxproj text eol=crlf

# 二进制/大文件：不做任何转换，也不在 diff 里显示内容
*.gguf        binary
*.safetensors binary
*.bin         binary
*.onnx        binary
*.sbs         binary
*.dll         binary
*.exe         binary
*.a           binary
*.lib         binary
*.o           binary
*.obj         binary
*.png         binary
*.jpg         binary
*.ico         binary
